# committed; only generated output, the local SDK path, and signing config are not.
**/android/.gradle/
**/android/.kotlin/
**/android/captures/
**/android/build/
**/android/app/build/
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
**/android/.cxx/
**/android/local.properties
**/android/key.properties

# RELEASE-KEY-AND-PIPELINE-001 — production signing material.
# The real keystore and its properties file live OUTSIDE this repository; these
# rules are the second line of defence for the case where someone copies one in
# "just for a moment". *.jks / *.keystore / *.p12 / *.pfx are already ignored
# above. Only the *.example template is allowed to be tracked.
key.properties
signing.properties
release-signing.properties
*-signing.properties
signing.properties.local
!tools/android_release/signing.properties.example
**/android/**/GeneratedPluginRegistrant.java
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
**/Flutter/ephemeral/
.symlinks/
macos/Pods/
linux/flutter/ephemeral/
windows/flutter/ephemeral/
web/.dart_tool/

