# STOREFRONT-READ-001 - server-only configuration of the storefront's read source.
# Every name here is read on the SERVER ONLY (src/source/storefront.ts and
# src/source/live/client.ts). None is a NEXT_PUBLIC_ name and none reaches a
# client bundle; tests/output/output.test.mjs scans every emitted chunk for
# them. Copy to .env.local (gitignored) for a local run; never commit values.
#
# fixture (default): the UI-001 fixture tenant `maps-burger`, no network.
# live: the real read of published storefronts through public.storefront_menu.
STOREFRONT_SOURCE=fixture

# Required only when STOREFRONT_SOURCE=live. The Supabase project API origin
# (https://<project-ref>.supabase.co) and its PUBLISHABLE anon key - the key
# the D-037 allowlist is designed for. Never a service-role key.
STOREFRONT_SUPABASE_URL=
STOREFRONT_SUPABASE_ANON_KEY=
