<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Network access for real-backend (Supabase) mode: login, device pairing,
         and sync. flutter create only grants this in the debug and profile
         source sets, so the release (main) manifest must declare it too, or a
         release build's pilot APK would have no network access (ANDROID-001). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Bluetooth Classic (SPP) thermal printing (ANDROID-003). Android 12+
         (API 31+) uses the runtime BLUETOOTH_CONNECT (connect to a bonded
         printer) + BLUETOOTH_SCAN; "neverForLocation" declares scan does not
         derive location, so ACCESS_FINE_LOCATION is NOT needed (the MVP uses
         already-paired devices, no in-app discovery). Older Android uses the
         legacy BLUETOOTH / BLUETOOTH_ADMIN (capped at API 30). -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <!-- KITCHEN-MODE-001C2A: targeted backup exclusions (Keystore-wrapped
         secure storage + the future encrypted kitchen-spool directory) so a
         cloud restore / device transfer can never recreate secrets or the
         spool in a mismatched key/data state. Application backup itself
         stays enabled (Android's default). -->
    <application
        android:label="BIZBOT POS"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <!-- Private sideloaded pilot only. User-visible and stoppable; no media/remoteMessaging impersonation. -->
        <service android:name=".BackgroundOrderAlertService" android:exported="false"
            android:enabled="${bizbotBackgroundAlertsEnabled}" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-enabled, bounded audible alert for server-verified pending pickup requests on this paired POS; expires within fifteen minutes and stops on status, logout or user Stop." />
        </service>
        <service android:name=".BackgroundOrderAlertMessagingService" android:exported="false"
            android:enabled="${bizbotBackgroundAlertsEnabled}">
            <intent-filter><action android:name="com.google.firebase.MESSAGING_EVENT" /></intent-filter>
        </service>
        <receiver android:name=".BackgroundOrderAlertStopReceiver" android:exported="false"
            android:enabled="${bizbotBackgroundAlertsEnabled}" />
        <service android:name=".BackgroundOrderAlertJobService" android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" android:enabled="${bizbotBackgroundAlertsEnabled}" />
        <provider android:name=".BackgroundOrderAlertInitProvider" android:authorities="${applicationId}.backgroundorderalert.init"
            android:exported="false" android:initOrder="101" android:enabled="${bizbotBackgroundAlertsEnabled}" />
        <meta-data android:name="firebase_messaging_auto_init_enabled" android:value="false" />
        <meta-data android:name="firebase_analytics_collection_enabled" android:value="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- PERF-112: production compatibility policy (owner-accepted). PowerVR
             hardware (Acer Iconia A16 / Allwinner A733 / PowerVR BXM) showed severe
             Impeller/Vulkan jank and ghosted/stale frames; the same-device PERF-111
             A/B with only this flag changed was "MUCH BETTER" on Skia/OpenGL.
             Keep Impeller disabled for POS/Kiosk until a verified Flutter engine
             upgrade resolves the affected device class (re-test on the Acer before
             removing). See docs/android-renderer-compatibility.md. -->
        <meta-data
            android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="false" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
